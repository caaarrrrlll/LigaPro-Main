@model CarlosM_LigaPro.Models.Jugador

@{
    ViewData["Title"] = "Create";
}

<h2>Crear Jugador</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Nombre" class="control-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="NumeroCamiseta" class="control-label"></label>
        <input asp-for="NumeroCamiseta" class="form-control" />
        <span asp-validation-for="NumeroCamiseta" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EquipoId" class="control-label"></label>
        <select asp-for="EquipoId" class="form-control" asp-items="ViewBag.Equipos"></select>
        <span asp-validation-for="EquipoId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
</form>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
